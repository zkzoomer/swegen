# Get your API key from https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# Exact name of the active SWE Multimodal worker snapshot in Daytona
DAYTONA_SNAPSHOT=

# Hard wall-clock limit for every sandbox, including one whose controller dies.
DAYTONA_SANDBOX_MAX_LIFETIME_MINUTES=240
# Failed jobs are stopped immediately, retained this long for recovery, then deleted.
DAYTONA_SANDBOX_RECOVERY_RETENTION_MINUTES=120

# rv judge mode: openrouter (default) or codex (local Codex subscription).
# Codex mode requires no OpenRouter key or rv auth file. Both modes validate
# the transferred Codex login before task agents or QC start.
SWEGEN_RV_MODE=openrouter

# OpenRouter mode only: optional credential-file override. The controller reads
# openrouter_api_key from $HOME/.rv/auth.json unless OPENROUTER_API_KEY is set,
# and injects it into the disposable sandbox at runtime.
# Never put the key itself in this file or in the worker snapshot.
# RV_AUTH_PATH=/absolute/path/to/.rv/auth.json

# Both agents run locally and reuse the local Codex login.
# Outer model; Helix controls the recorded inner session configuration.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium

# Local directory for handoff ZIPs, persistent task staging and review logs
LOCAL_OUTPUT_DIR=./outputs

# Proprietary kit source required for task jobs, kept OUTSIDE this repository.
# The controller uploads the required kit files into the private running worker.
# The authoring skill stays local; neither is baked into the snapshot.
MEDIA_CAPTURE_KIT_DIR=

# Verify the account locally with helix status. No worker pairing is used.
